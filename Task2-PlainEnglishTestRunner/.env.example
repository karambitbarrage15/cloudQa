# Google Gemini API Key (recommended for multimodal visual reasoning)
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: OpenAI API Key (if using --provider openai)
OPENAI_API_KEY=

# Default browser execution mode (true = headless, false = visible browser window)
HEADLESS=false

# Default timeout per action in milliseconds
ACTION_TIMEOUT_MS=15000

# Maximum autonomous exploration steps before termination
MAX_STEPS=15
